# RPA Anuncio Navio 2003 — CODEBA OpenPort (somente disco local)
# Copie para .env e preencha. Durante desenvolvimento, QAS e o destino padrao.
# PROD so deve ser escolhido explicitamente e exige autorizacao.
OPENPORT_URL=https://ilheus.codeba.gov.br/qas/openportcodeba/
# PROD (operacao; exige PERMITIR_PROD=1 e CONFIRMAR_ANUNCIO=1):
# OPENPORT_URL=https://openportilheus.codeba.gov.br/openportcodeba/

OPENPORT_LOGIN=seu_usuario
OPENPORT_SENHA=sua_senha

# Navegador
PRIMEIRO_PLANO=true
HEADLESS=false
TIMEOUT_MS=30000
SLOW_MO_MS=300
PAUSA_VISUAL_MS=500
MANTER_ABERTO_SEG=60
MANTER_ABERTO=false
