# RPA Anuncio Navio 2003 — CODEBA OpenPort (somente disco local)
# Copie para .env e preencha. QAS = testes, PROD = producao.
# PROD (operacao; exige PERMITIR_PROD=1 para abrir o navegador):
OPENPORT_URL=https://openportilheus.codeba.gov.br/openportcodeba/
# QAS (testes):
# OPENPORT_URL=https://ilheus.codeba.gov.br/qas/openportcodeba/

OPENPORT_LOGIN=seu_usuario
OPENPORT_SENHA=sua_senha

# Navegador
PRIMEIRO_PLANO=true
HEADLESS=false
TIMEOUT_MS=30000
SLOW_MO_MS=300
PAUSA_VISUAL_MS=500
MANTER_ABERTO_SEG=60
MANTER_ABERTO=false
